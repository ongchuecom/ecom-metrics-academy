# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# --- bắt buộc (thiếu là máy chủ từ chối khởi động) ---
GEMINI_API_KEY=                 # aistudio.google.com → Get API key
FIREBASE_PROJECT_ID=            # projectId trong firebaseConfig (giống site.json → auth.firebase.projectId)
SEPAY_WEBHOOK_KEY=              # chuỗi ngẫu nhiên ≥ 24 ký tự: openssl rand -hex 24 ; dán y hệt vào SePay (kiểu xác thực API Key)
BANK_BIN=970422                 # mã BIN ngân hàng nhận tiền (970422 = MB Bank)
BANK_ACCOUNT=                   # số tài khoản nhận tiền (đã liên kết SePay)
BANK_ACCOUNT_NAME=              # tên chủ tài khoản, VIẾT HOA KHÔNG DẤU
# --- nên điền ---
ADMIN_UIDS=                     # uid Firebase của quản trị viên, cách nhau dấu phẩy (giống site.json → admin.uids)
ALLOWED_ORIGINS=https://ongchuecom.github.io
SITE_URL=https://ongchuecom.github.io/ecom-metrics-academy/
TRUST_PROXY=1                   # 1 khi chạy sau nginx của mình (deploy.sh cấu hình sẵn)
DB_PATH=/opt/ecom-advisor/data/advisor.db
# --- tùy chọn ---
CHAT_MODEL=gemini-flash-latest  # có thể ghim một bản cố định, xem ai.google.dev/gemini-api/docs/models
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768                   # đổi mô hình hoặc số chiều thì phải bấm "Đồng bộ từ web" để tạo lại embedding
# GOOGLE_APPLICATION_CREDENTIALS=/opt/ecom-advisor/service_account.json   # chỉ cần nếu đồng bộ Google Drive

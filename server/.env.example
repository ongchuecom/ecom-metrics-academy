# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Mỗi dòng chỉ có TÊN=giá trị, không viết chú thích phía sau giá trị (systemd sẽ coi chú thích là một phần giá trị).
# --- bắt buộc (thiếu là máy chủ từ chối khởi động) ---
# aistudio.google.com → Get API key
GEMINI_API_KEY=
# projectId trong firebaseConfig (giống site.json → auth.firebase.projectId)
FIREBASE_PROJECT_ID=
# chuỗi ngẫu nhiên ≥ 24 ký tự: openssl rand -hex 24 ; dán y hệt vào SePay (kiểu xác thực API Key)
SEPAY_WEBHOOK_KEY=
# mã BIN ngân hàng nhận tiền (970422 = MB Bank)
BANK_BIN=970422
# số tài khoản nhận tiền (đã liên kết SePay)
BANK_ACCOUNT=
# tên chủ tài khoản, VIẾT HOA KHÔNG DẤU
BANK_ACCOUNT_NAME=
# --- nên điền ---
# uid Firebase của quản trị viên, cách nhau dấu phẩy (giống site.json → admin.uids)
ADMIN_UIDS=
ALLOWED_ORIGINS=https://ongchuecom.github.io
SITE_URL=https://ongchuecom.github.io/ecom-metrics-academy/
# 1 khi chạy sau nginx của mình (deploy.sh cấu hình sẵn)
TRUST_PROXY=1
DB_PATH=/opt/ecom-advisor/data/advisor.db
# --- tùy chọn ---
# có thể ghim một bản cố định, xem ai.google.dev/gemini-api/docs/models
CHAT_MODEL=gemini-flash-latest
EMBED_MODEL=gemini-embedding-2
# đổi mô hình hoặc số chiều thì phải bấm "Đồng bộ từ web" để tạo lại embedding
EMBED_DIM=768
# chỉ cần nếu đồng bộ Google Drive
# GOOGLE_APPLICATION_CREDENTIALS=/opt/ecom-advisor/service_account.json
